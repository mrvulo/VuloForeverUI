{
  "name": "vuloforeverui-tools",
  "private": true,
  "description": "Pre-release checks for VuloForeverUI (syntax, locals cap, locale coverage, naming rules)",
  "scripts": {
    "check": "node check.js",
    "seed": "node sv-seed.js",
    "seed:watch": "node sv-seed.js --watch",
    "secrets": "node secretlint.js",
    "secrets:all": "node secretlint.js --all",
    "secrets:baseline": "node secretlint.js --write-baseline",
    "api": "node apilint.js",
    "api:update": "node apilint.js --update",
    "api:baseline": "node apilint.js --write-baseline"
  },
  "dependencies": {
    "luaparse": "^0.3.1"
  },
  "devDependencies": {
    "wow-secret-lint": "^1.7.0"
  }
}
