#!/bin/sh
# Refuses a commit the checker does not pass. Skip once with: git commit --no-verify
cd "$(git rev-parse --show-toplevel)/tools" || exit 1
out=$(node check.js 2>&1)
if printf '%s\n' "$out" | grep -q '^RESULT: OK'; then exit 0; fi
printf '%s\n' "$out" | tail -40
echo
echo "pre-commit: tools/check.js failed, commit refused."
exit 1
