# Build recipe for the BigWigs packager (github.com/BigWigsMods/packager).
#
# The packager checks the repo out at a tag, strips everything listed under
# `ignore`, zips what is left with `package-as` as the top folder, and uploads
# that to CurseForge and to a GitHub release.
#
# The libraries under Libs/ are committed to this repo on purpose and are NOT
# declared as `externals`: they are what the addon was tested against, and a
# build that silently pulls newer copies is a build nobody tested.

package-as: VuloForeverUI

# The notes the packager publishes. WITHOUT this it builds them from the commit
# messages since the last tag, which is a different audience's text: commits are
# written for whoever works on the addon, release notes for whoever plays with
# it. This file is the second kind.
manual-changelog:
  filename: CHANGELOG-release.md
  markup-type: markdown

# Everything that only serves development.
ignore:
  - tools
  - docs
  - CLAUDE.md
  - .pkgmeta
  - .gitignore
  - "*.zip"

# No stripped-down "nolib" package: the libraries are part of the addon.
enable-nolib-creation: no
